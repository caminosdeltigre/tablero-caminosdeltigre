rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Solo usuarios con sesión iniciada pueden leer y escribir.
    // Para limitarlo a correos del INVÍAS, cambie la condición por:
    //   request.auth != null && request.auth.token.email.matches('.*@invias[.]gov[.]co$')
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
